# Discord OAuth2 – erstelle eine App unter https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Die Callback-URL, die du in der Discord App unter OAuth2 -> Redirects einträgst
DISCORD_REDIRECT_URI=http://example.com/api/auth/callback

# Die ID deines Pfotenclub Discord-Servers (Rechtsklick auf Server -> ID kopieren)
DISCORD_GUILD_ID=

# Die ID der "Burgeramt"-Rolle auf dem Discord-Server (Rollen-Einstellungen -> Rolle -> ID kopieren)
# Wird benötigt, damit der Announcement-Link im Header nur für Mitglieder mit dieser Rolle sichtbar ist
DISCORD_BURGERAMT_ROLE_ID=

# Beliebiger langer Zufallsstring zum Signieren der Session-Cookies
# Beispiel: openssl rand -base64 32
SESSION_SECRET=

# Discord Webhook URL für Bestellbenachrichtigungen
# Erstellen: Server → Einstellungen → Integrationen → Webhooks → Neuer Webhook
DISCORD_ORDER_WEBHOOK_URL=

# Deine Discord User-ID für den Admin-Ping (Entwicklermodus → Rechtsklick auf dich → ID kopieren)
DISCORD_ADMIN_USER_ID=

# Fabaxi API URL
FABAXI_API_URL=http://localhost:8080

# Fabaxi API Key
# Beliebiger langer Zufallsstring zum Authentifizieren bei der Fabaxi API
# Beispiel: openssl rand -base64 32
FABAXI_API_KEY=
