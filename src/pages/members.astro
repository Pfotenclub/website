---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const avatarImports = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/members/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

function getAvatar(file: string | null): ImageMetadata | null {
  if (!file) return null;
  for (const [path, mod] of Object.entries(avatarImports)) {
    const basename = path.split('/').pop()?.replace(/\.[^.]+$/, '');
    if (basename === file) return mod.default;
  }
  return null;
}

const members = [
  {
