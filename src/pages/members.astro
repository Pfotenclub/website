const categories = [
  { id: "all", label: "All" },
  { id: "cult-leader", label: "Cult Leader" },
  { id: "burgeramt", label: "Burgeramt" },
  { id: "member", label: "Members" },
];

const membersWithAvatars = members.map(m => ({
  ...m,
  avatarSrc: getAvatar(m.avatarFile),
}));
---

<Layout title="Members">
  <h2>Members</h2>
  <p>Choose a category to learn more about our members.</p>

  <div class="filter-bar">
    {categories.map((cat) => (
      <button
        class="filter-btn"
        data-category={cat.id}
        aria-pressed={cat.id === "all" ? "true" : "false"}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <div class="members-grid">
    {membersWithAvatars.map((m, i) => (
      <div class="member-card" data-category={m.category}>
        <div class="member-avatar-wrap">
          {m.avatarSrc
            ? <Image src={m.avatarSrc} alt={m.name} width={64} height={64} class="member-avatar-img" loading={i < 18 ? "eager" : "lazy"} />
            : <span class="member-avatar-fallback">{m.name[0]}</span>
          }
        </div>
        <div class="member-info">
          <h3>{m.name}</h3>
          <span class="member-role">{m.role}</span>
          <p>{m.description}</p>
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }

  .filter-btn {
    padding: 0.4rem 1rem;
    border: 2px solid var(--accent, #888);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
  }

  .filter-btn[aria-pressed="true"],
  .filter-btn:hover {
    background: var(--accent, #888);
    color: #fff;
  }

  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .member-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid rgba(128,128,128,0.3);
    border-radius: 0.75rem;
    transition: opacity 0.2s, transform 0.2s;
  }

  .member-card.hidden {
    display: none;
  }

  .member-avatar-wrap {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
  }

  .member-avatar-img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .member-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent, #888);
    color: #fff;
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
  }

  .member-info h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .member-role {
    font-size: 0.8rem;
    opacity: 0.7;
    display: block;
    margin-bottom: 0.4rem;
  }

  .member-info p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.member-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.category!;

      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');

      cards.forEach((card) => {
        const match = selected === 'all' || card.dataset.category === selected;
        card.classList.toggle('hidden', !match);
      });
    });
  });
</script>
