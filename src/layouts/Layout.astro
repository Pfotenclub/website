---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Pfotenclub{title ? ` | ${title}` : ''}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Fredoka:wght@400;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #e8eaf0;
		--color-secondary: #9da8d4;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}

	body {
		color: var(--color-secondary);
		background: radial-gradient(ellipse at center, #131b4a 0%, #0a0f2e 50%, #060a18 100%);
		background-attachment: fixed;
		display: flex;
		flex-direction: column;
		font: 400 1rem 'Nunito', sans-serif;
	}

	main {
		flex: 1;
		max-width: 1100px;
		width: 100%;
		margin: 0 auto;
		padding: 0 1.5rem;
		box-sizing: border-box;
	}

	h1 {
		font-size: 3rem;
		color: var(--color-primary);
		text-align: center;
		margin-top: 2rem;
		margin-bottom: 0;
	}

	h2 {
		font-size: 1.5rem;
		color: var(--color-primary);
		text-align: center;
		margin-top: 0.5rem;
	}

	h3 {
		font-size: 1rem;
		color: var(--color-primary);
		text-align: center;
		margin-top: 0.5rem;
	}

	p {
		font-size: 1rem;
		line-height: 1.5;
		margin: 1rem auto;
		max-width: 800px;
	}

	a {
		color: #8a9ff0;
		text-decoration: none;
		border-bottom: 1px solid rgba(138, 159, 240, 0.35);
		transition: color 0.2s, border-color 0.2s;
	}

	a:hover {
		color: var(--color-primary);
		border-bottom-color: rgba(232, 234, 240, 0.5);
	}
</style>

<style is:global>
  .fabaxi-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(2rem);
    background: #1e2a5e;
    color: #e8eaf0;
    border: 1px solid rgba(157,168,212,0.3);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-size: 0.9rem;
    opacity: 0;
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
    z-index: 9999;
    white-space: nowrap;
  }
  .fabaxi-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  if (!document.cookie.split(';').some(c => c.trim().startsWith('fabaxi='))) {
    document.cookie = 'fabaxi=🍪; path=/; max-age=31536000; SameSite=Lax';
    const toast = document.createElement('div');
    toast.className = 'fabaxi-toast';
    toast.textContent = '🍪 Fabaxi has given you a cookie!';
    document.body.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 50);
    setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3500);
  }
</script>
