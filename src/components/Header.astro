---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/blog', label: 'Blog & News' },
  { href: '/gallery', label: 'Photo Gallery' },
  { href: '/members', label: 'Member Info' },
  { href: '/shop', label: 'Shop' },
];
---

<header>
  <nav>
    <a href="/" class="logo">Pfotenclub</a>
    <button class="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');

  hamburger?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
    hamburger.classList.toggle('active');
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 15, 46, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(100, 140, 255, 0.15);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-family: 'Fredoka', sans-serif;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: all 0.3s;
  }

  .hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(10, 15, 46, 0.95);
      border-bottom: 1px solid rgba(100, 140, 255, 0.15);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li a {
      display: block;
      padding: 1rem 2rem;
      border-top: 1px solid rgba(100, 140, 255, 0.1);
    }
  }
</style>
