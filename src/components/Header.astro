---
import { verifySessionCookie, avatarUrl, SESSION_COOKIE } from '../lib/session';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog & News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/members', label: 'Member Info' },
  { href: '/shop', label: 'Shop' },
  { href: 'https://discord.gg/pfotenclub', label: 'Discord', external: true },
];

const sessionCookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const session = sessionCookie
  ? verifySessionCookie(sessionCookie, process.env.SESSION_SECRET ?? '')
  : null;

const links = session?.isBurgeramt
  ? [...navLinks, { href: '/announcement', label: 'Announcement' }]
  : navLinks;
---

<header>
  <nav>
    <a href="/" class="logo">
      <img src="/logo.png" alt="Pfotenclub Logo" width="40" height="40" />
      Pfotenclub</a>
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" id="nav-menu">
      {links.map(link => (
        <li>
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
            {link.label}
            {link.external && (
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            )}
          </a>
        </li>
      ))}
      <li class="auth-item">
        {session ? (
          <div class="user-info">
            <img
              class="user-avatar"
              src={avatarUrl(session.userId, session.avatar)}
              alt={session.username}
              width="28"
              height="28"
            />
            <span class="username">{session.username}</span>
            <a href="/api/auth/logout" class="logout-btn">Logout</a>
          </div>
        ) : (
          <a href="/api/auth/discord" class="login-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
            </svg>
            Login
          </a>
        )}
      </li>
    </ul>
  </nav>
</header>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    hamburger.classList.toggle('active');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 15, 46, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(100, 140, 255, 0.15);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a {
    font-family: 'Fredoka', sans-serif;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.6;
    border-bottom: none;
  }

  .nav-links a svg {
    margin-left: 3px;
    vertical-align: middle;
    opacity: 0.6;
  }

  /* Login / Logout */
  .auth-item {
    margin-left: 0.5rem;
  }

  .login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fredoka', sans-serif;
    font-size: 0.95rem;
    color: #fff !important;
    background: #5865F2;
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
    text-decoration: none !important;
    transition: background 0.2s, opacity 0.2s;
    white-space: nowrap;
  }

  .login-btn:hover {
    background: #4752c4;
    opacity: 1 !important;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .user-avatar {
    border-radius: 50%;
    display: block;
  }

  .username {
    font-family: 'Fredoka', sans-serif;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .logout-btn {
    font-family: 'Fredoka', sans-serif;
    font-size: 0.85rem;
    color: var(--color-secondary) !important;
    text-decoration: none;
    border: 1px solid rgba(100, 140, 255, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    transition: border-color 0.2s, opacity 0.2s;
  }

  .logout-btn:hover {
    border-color: rgba(100, 140, 255, 0.7);
    opacity: 1 !important;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: all 0.3s;
  }

  .hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(10, 15, 46, 0.95);
      border-bottom: 1px solid rgba(100, 140, 255, 0.15);
      align-items: stretch;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li a {
      display: block;
      padding: 1rem 2rem;
      border-top: 1px solid rgba(100, 140, 255, 0.1);
    }

    .auth-item {
      margin-left: 0;
      padding: 0.75rem 2rem;
      border-top: 1px solid rgba(100, 140, 255, 0.1);
    }

    .user-info {
      padding: 0;
    }
  }
</style>
