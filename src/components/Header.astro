---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog & News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/members', label: 'Member Info' },
  { href: '/shop', label: 'Shop' },
  { href: 'https://discord.gg/pfotenclub', label: 'Discord', external: true },
];
---

<header>
  <nav>
    <a href="/" class="logo">
      <img src="/logo.png" alt="Pfotenclub Logo" width="40" height="40" />
      Pfotenclub</a>
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" id="nav-menu">
      {navLinks.map(link => (
        <li>
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
            {link.label}
            {link.external && (
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    hamburger.classList.toggle('active');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 15, 46, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(100, 140, 255, 0.15);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-family: 'Fredoka', sans-serif;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  .nav-links a svg {
    margin-left: 3px;
    vertical-align: middle;
    opacity: 0.6;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: all 0.3s;
  }

  .hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(10, 15, 46, 0.95);
      border-bottom: 1px solid rgba(100, 140, 255, 0.15);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li a {
      display: block;
      padding: 1rem 2rem;
      border-top: 1px solid rgba(100, 140, 255, 0.1);
    }
  }
</style>
