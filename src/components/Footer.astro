---
const currentYear = new Date().getFullYear();
---

<footer>
    <hr />
    <p>Made with pure hatred by <a href="https://github.com/DiniskaWolfiii" target="_blank" rel="noopener noreferrer">Wolfiii</a> © {currentYear}</p>
</footer>

<style>
    footer {
        text-align: center;
        padding: 2rem;
        margin-top: auto;
        font-size: 1rem;
        font: 400 1rem 'Fredoka', sans-serif;
    }

    hr {
        border: none;
        border-top: 1px solid rgba(100, 140, 255, 0.2);
        margin-bottom: 1.5rem;
    }

    p {
        color: #8892b0;
    }

    a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: opacity 0.2s;
    }

    a:hover {
        opacity: 0.6;
    }
</style>